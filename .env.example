# Required in Dokploy: persists leads, activity, and the encrypted Twilio connection.
DATABASE_URL=postgresql://postgres:password@database:5432/postgres
# Required before saving a Twilio connection. Use a long, unique secret in Dokploy.
OPEN_DIALER_ENCRYPTION_KEY=replace-with-a-long-random-secret
# Required for the production operator sign-in page.
OPEN_DIALER_ADMIN_PASSWORD=replace-with-a-long-unique-password
# Recommended in production so Twilio can request the signed bridge URL.
OPEN_DIALER_PUBLIC_URL=https://dialer.example.com
# Optional. The application defaults to 3000 in Docker.
PORT=3000
