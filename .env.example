# Copy to .env, or let scripts/setup.mjs (Install Open Dialer.bat) write one for you.
# Postgres: the local Docker database the setup script makes, or a hosted one.
DATABASE_URL=postgres://opendialer:choose-a-password@127.0.0.1:5433/opendialer
# Encrypts saved Twilio, AI and email keys. A long random secret; never change it once keys are saved.
OPEN_DIALER_ENCRYPTION_KEY=replace-with-a-long-random-secret
# Hosted copies only: the public HTTPS address Twilio and email links use. The local start script sets it for you.
# OPEN_DIALER_PUBLIC_URL=https://dialer.example.com
# Optional fallbacks; each company can save its own keys in Settings instead.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# GROQ_API_KEY=
# Optional. Defaults to 3000.
# PORT=3000
